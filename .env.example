# Copy this file to .env (same directory as docker-compose.yml) to override
# the defaults baked into docker-compose.yml. Docker Compose loads .env
# automatically — nothing else to configure. If you don't create a .env
# file at all, the stack still runs fine using the defaults shown here.
#
#   cp .env.example .env

# HMAC signing key every service uses to sign/verify JWTs. Must be identical
# across all services (they all read the same variable) and long enough for
# HS256 (32+ bytes / 256+ bits recommended).
JWT_SECRET=change-this-super-secret-banking-platform-signing-key-min-256-bits

# Shared secret for the X-Internal-Api-Key header used on service-to-service
# calls that don't carry a user's JWT (see e.g. Account Service's
# /accounts/internal/** endpoints). Also change together across all services.
INTERNAL_API_KEY=change-this-internal-service-key

# MySQL root password (only used by the mysql container itself and its
# healthcheck — application services connect as banking_app, created by
# docker/mysql-init/01-create-app-user.sql).
MYSQL_ROOT_PASSWORD=rootpw

# Grafana's initial admin login (http://localhost:3000).
GRAFANA_ADMIN_PASSWORD=admin
