# Maven build output — every module's compiled classes, test reports, and
# packaged jars. Never commit this; `mvn clean verify` regenerates it.
target/
*.class

# IDE metadata — machine-specific, regenerated on import. IntelliJ recreates
# .idea/ and *.iml on "Open" from the pom.xml; nothing here is meant to be shared.
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# Local environment overrides — .env holds real secrets once copied from
# .env.example (see that file's header comment). Never commit real secrets,
# even dev ones; .env.example is the template that IS meant to be committed.
.env

# OS noise
.DS_Store
Thumbs.db

# Logs generated by services running outside Docker (e.g. via IntelliJ)
*.log
logs/

# Kafka/MySQL/Redis/Grafana/Prometheus data volumes if ever bind-mounted
# locally instead of using named Docker volumes
/data/
